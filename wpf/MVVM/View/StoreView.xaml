<Page x:Class="Shawarmas.MVVM.View.StoreView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Shawarmas.MVVM.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StoreView">

    <Grid Background="#1C1C1C">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer 
            Grid.Column="0"
            Grid.Row="0"
            Margin="10"
            VerticalScrollBarVisibility="Auto">
            
            <ItemsControl 
                ItemsSource="{Binding Pedidos}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding NumColumnas}" Rows="{Binding NumFilas}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button 
                            Command="{Binding DataContext.SeleccionarPedidoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource OrderButtonCard}"
                            Padding="15"
                            Width="140"
                            Height="120"
                            Margin="5"
                            Background="#2C2C2C"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5">

                            <StackPanel>
                                <TextBlock 
                                    Text="Order #" 
                                    Foreground="#CCC" 
                                    FontWeight="SemiBold" 
                                    FontSize="14"/>

                                <TextBlock 
                                    Text="{Binding IdPedido}" 
                                    Foreground="#FFF" 
                                    FontWeight="Bold" 
                                    FontSize="18"/> 

                                <TextBlock 
                                    Text="{Binding Cliente.Nombre}" 
                                    Foreground="#EEE"
                                    FontSize="14"/> 

                                <TextBlock 
                                    Text="{Binding FechaPedido, StringFormat=d}" 
                                    Foreground="#AAA" 
                                    FontSize="12"/> 
                                
                            </StackPanel>
                        </Button> 
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer> 

        <Border 
            Grid.Row="1"
            Grid.Column="0"
            Background="#2C2C2C"
            CornerRadius="10"
            Padding="10"
            Margin="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.75*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock 
                    Text="Add Products"
                    FontWeight="Bold"
                    FontSize="16"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Foreground="#FFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"/> 

                <TextBlock 
                    Text="Brand:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="0"/>

                <TextBox
                    x:Name="TxtBrand"
                    Width="Auto"
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="#FFF"
                    BorderBrush="#666"/>

                <TextBlock 
                    Text="Model:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="2"/>

                <TextBox
                    x:Name="TxtModel"
                    Width="Auto"
                    Grid.Row="1"
                    Grid.Column="3"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="#FFF"
                    BorderBrush="#666"/>
                
                <TextBlock 
                    Text="Stock:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="4"/>

                <TextBox
                    x:Name="TxtStock"
                    PreviewTextInput="NumberValidationHandler"
                    PreviewKeyDown="NumberKeyDownHandler"
                    Width="Auto"
                    Grid.Row="1"
                    Grid.Column="5"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="#FFF"
                    BorderBrush="#666"/>
                
                <TextBlock 
                    Text="Category:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="0"/>

                <ComboBox
                    x:Name="CmbCategory"
                    Width="Auto"
                    Grid.Row="2"
                    Grid.Column="1"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="Black"
                    BorderBrush="#666"/>

                <TextBlock 
                    Text="Colour:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="2"/>
                
                <ComboBox
                    x:Name="CmbColour"
                    Width="Auto"
                    Grid.Row="2"
                    Grid.Column="3"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="Black"
                    BorderBrush="#666"/>

                <TextBlock 
                    Text="Size:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="4"/>

                <ComboBox
                    x:Name="CmbSize"
                    Width="Auto"
                    Grid.Row="2"
                    Grid.Column="5"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="Black"
                    BorderBrush="#666"/>

                <TextBlock 
                    Text="Price:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="0"/>

                <TextBox
                    x:Name="TxtPrice"
                    PreviewTextInput="NumberValidationHandler"
                    PreviewKeyDown="NumberKeyDownHandler"
                    Language="es-ES"
                    Width="Auto"
                    Grid.Row="3"
                    Grid.Column="1"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="#FFF"
                    BorderBrush="#666"/>

                <TextBlock 
                    Text="Image:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="2"/>

                <Button
                    Content="Browse..."
                    Style="{StaticResource DefaultButton}"
                    Width="80"
                    x:Name="BtnBrowseImage"
                    Height="20"
                    Grid.Row="3"
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    Background="#FFF0F0F0"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand" Click="BtnBrowseImage_Click"/> 

                <Button
                    Content="Add Product"
                    Style="{StaticResource DefaultButton}"
                    Width="100"
                    Height="20"
                    Grid.Row="3"
                    x:Name="BtnAddProduct"
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Background="#FFF0F0F0"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand" Click="BtnAddProduct_Click"/>
                
            </Grid>

        </Border> 

        <ContentControl 
            Grid.Column="1" 
            Content="{Binding PedidoSeleccionado}" 
            Margin="10">

            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border 
                        Background="#2C2C2C" 
                        CornerRadius="10" 
                        Padding="10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock 
                                Grid.Row="0"
                                Text="Items" 
                                FontWeight="Bold" 
                                HorizontalAlignment="Center"
                                FontSize="16" 
                                Foreground="#FFF" 
                                Margin="0,0,0,5"/>

                            <ScrollViewer 
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                Margin="5">

                                <ItemsControl ItemsSource="{Binding Productos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border 
                                                Background="#333" 
                                                CornerRadius="8" 
                                                Padding="8" 
                                                Margin="0,5">

                                                <StackPanel 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Center">

                                                    <TextBlock 
                                                        Visibility="Collapsed" 
                                                        x:Name="rutaGenerada" 
                                                        Text="{Binding Imagen, StringFormat=/Resources{0}}"/>

                                                    <Image 
                                                        Source="{Binding ElementName=rutaGenerada, Path=Text}" 
                                                        Width="75" 
                                                        Height="75" 
                                                        Margin="10,0,10,0"/>

                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Margin="5,0,15,0">
                                                        
                                                        <TextBlock 
                                                            Text="{Binding Marca}"
                                                            FontWeight="Bold"
                                                            Foreground="#FFF"/>

                                                        <TextBlock 
                                                            Text="{Binding Modelo}" 
                                                            Foreground="#CCC"/>
                                                        
                                                    </StackPanel>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock 
                                                            Text="{Binding Precio, StringFormat=C}"
                                                            Foreground="#AAA"/>

                                                        <TextBlock Foreground="#AAA">
                                                            <Run Text="Size:"/>
                                                            <Run Text="{Binding Talla}"/>
                                                        </TextBlock>

                                                        <TextBlock Foreground="#AAA">
                                                            <Run Text="x"/>                                                         
                                                            <Run Text="{Binding Cantidad}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer> 

                            <StackPanel Grid.Row="2">
                                <Border 
                                    Background="#3A3A3A" 
                                    CornerRadius="8" 
                                    Padding="12" 
                                    Margin="0">

                                    <StackPanel>
                                        <TextBlock 
                                            Text="Details" 
                                            FontWeight="Bold" 
                                            HorizontalAlignment="Center"
                                            FontSize="11" 
                                            Foreground="#FFF" 
                                            Margin="0,0,0,5"/>

                                        <TextBlock Foreground="#FFF" FontSize="9" Margin="0,0,0,0" TextWrapping="Wrap">
                                            <Run Text="{Binding Cliente.Nombre, FallbackValue='Name'}"/>
                                            <Run Text="{Binding Cliente.Apellido1}"/>
                                            <Run Text="{Binding Cliente.Apellido2}"/>
                                            <LineBreak/>
                                            <Run Text="{Binding Cliente.Mail, FallbackValue='Mail'}" />
                                            <LineBreak/>
                                            <Run Text="{Binding Calle, FallbackValue='Address'}" />
                                            <LineBreak/>
                                            <Run Text="{Binding Ciudad, FallbackValue='City'}"/>
                                            <Run Text=", " />
                                            <Run Text="{Binding Pais, FallbackValue='Country'}" />
                                            <LineBreak/>
                                            <Run Text="{Binding Postal, FallbackValue='ZIP'}" />
                                        </TextBlock>

                                        <TextBlock 
                                            Text="{Binding FechaPedido, StringFormat='Date: {0:dd/MM/yyyy}', FallbackValue='Date: Pending'}" 
                                            Foreground="#CCC" 
                                            FontSize="9"/>
                                        
                                    </StackPanel>
                                </Border>

                                <Button 
                                    Style="{StaticResource StatusOrdenButton}"
                                    Command="{Binding DataContext.MarcarComoCompletadoCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                    CommandParameter="{Binding}"
                                    Content="Marcar como entregado"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0"
                                    Width="110" 
                                    Height="25" Cursor="Hand"/> 
                                
                            </StackPanel> 
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl> 

        <Border 
            Grid.Row="1"
            Grid.Column="1"
            Background="#2C2C2C"
            CornerRadius="10"
            Padding="10"
            Margin="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock 
                    Text="Grid Configuration"
                    FontWeight="Bold"
                    FontSize="16"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Foreground="#FFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"/> 


                <TextBlock 
                    Text="Rows:"
                    Foreground="#CCC"
                    Width="Auto"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Column="0"/>

                <TextBox
                    x:Name="TxtFilas"
                    Text="{Binding NumFilas}"
                    Width="Auto"
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="80"
                    MaxWidth="150"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    MaxHeight="20"
                    Foreground="#FFF"
                    BorderBrush="#666" Cursor=""/>


                <TextBlock 
                    Text="Columns:"
                    Foreground="#CCC"
                    Width="Auto"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Row="2"
                    Grid.Column="0"/>

                <TextBox
                    x:Name="TxtColumnas"
                    Text="{Binding NumColumnas}"
                    Width="Auto" 
                    MinWidth="80"
                    MaxWidth="150"
                    MaxHeight="20"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalContentAlignment="Center"
                    Background="#444"
                    Foreground="#FFF"
                    BorderBrush="#666"/> 

                <Button
                    x:Name="BtnInitialize"
                    Command="{Binding InicializarGrillaCommand}"
                    Content="Initialize Grid"
                    Style="{StaticResource DefaultButton}"
                    Width="100"
                    Height="25"
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Background="#FFF0F0F0"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand" 
                    Click="BtnInitialize_Click"/> 
                
            </Grid>
        </Border> 
    </Grid>
</Page>


