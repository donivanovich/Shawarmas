<Window x:Class="Shawarmas.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shawarmas"
        mc:Ignorable="d"
        Icon="/Resources/Icons/favicon.ico"
        WindowStartupLocation="CenterScreen"
        Title="Menú principal" Height="550" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="0.7*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button 
                x:Name="BtnEfforts"
                Style="{StaticResource ToolBarButtons}"
                Content="Comprar" 
                Width="Auto" 
                Height="Auto" 
                Grid.Column="0" 
                Click="BtnEfforts_Click"/> 

            <Button 
                x:Name="BtnConfiguration" 
                Style="{StaticResource ToolBarButtons}"
                Content="Configuración" 
                Width="Auto" 
                Height="Auto" 
                Grid.Column="1" 
                Click="BtnConfiguration_Click"/> 

            <Button 
                x:Name="BtnAbout" 
                Style="{StaticResource ToolBarButtons}"
                Content="Acerca de" 
                Width="Auto" Height="Auto" 
                Grid.Column="2" 
                Click="BtnAbout_Click"/> 

            <Button 
                x:Name="BtnExit" 
                Style="{StaticResource ToolBarButtons}"
                Content="Salir" 
                Width="Auto" 
                Height="Auto"
                Grid.Column="3" 
                Click="BtnExit_Click"/> 

        </Grid> 

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Frame
                Background="#0F0F0F"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                x:Name="MainFrame" 
                NavigationUIVisibility="Hidden"/> 

        </Grid> 

        <Grid
            Grid.Row="2"
            Background="Black">

            <StackPanel Orientation="Horizontal">
                <TextBlock 
                    Text=" Silenciar:"
                    Foreground="White"
                    FontWeight="bold"
                    FontSize="16"
                    VerticalAlignment="Center" 
                    Margin="10,0,10,0"/>
                
                <ToggleButton
                    x:Name="MuteToggle"
                    Click="MuteToggle_Click"
                    Style="{StaticResource ResolutionMuteToggleButton}"/> 

                <MediaElement 
                    x:Name="bgMusic"
                    Source="Resources/Music/music.mp3" 
                    LoadedBehavior="Play"
                    UnloadedBehavior="Stop"
                    Visibility="Hidden"
                    MediaEnded="BgMusic_MediaEnded"/> 

            </StackPanel>
        </Grid> 
    </Grid>
</Window>

