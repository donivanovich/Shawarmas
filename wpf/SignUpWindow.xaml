<Window x:Class="Shawarmas.MVVM.View.SignUpWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shawarmas.MVVM.View"
        mc:Ignorable="d"
        Icon="/Resources/Icons/favicon2.ico"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="Registro" Height="300" Width="450">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0.75*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,0,10,0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Nombre:"
                Grid.Row="0"
                FontSize="10"
                FontWeight="Bold"
                Height="15"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"/>

            <TextBlock
                Text="Primer apellido:"
                Grid.Row="1"
                FontSize="10"
                FontWeight="Bold"
                Height="15"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"/>

            <TextBlock
                Text="Segundo apellido:"
                Grid.Row="2"
                FontSize="10"
                FontWeight="Bold"
                Height="15"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"/>

            <TextBlock
                Text="Correo electrónico:"
                Grid.Row="3"
                FontSize="10"
                FontWeight="Bold"
                Height="15"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"/>

            <TextBlock
                Text="Contraseña:"
                Grid.Row="4"
                FontSize="10"
                FontWeight="Bold"
                Height="15"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"/>

        </Grid> 

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBox
                x:Name="TxtName"
                Grid.Row="0"
                FontSize="10"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                Width="200"
                Height="15"/> 
            
            <TextBox
                x:Name="TxtSurename1"
                Grid.Row="1"
                FontSize="10"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                Width="200"
                Height="15"/> 
            
            <TextBox
                x:Name="TxtSurename2"
                Grid.Row="2"
                FontSize="10"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                Width="200"
                Height="15"/> 
            
            <TextBox
                x:Name="TxtEmail"
                Grid.Row="3"
                FontSize="10"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                Width="200"
                Height="15"/> 
            
            <PasswordBox
                x:Name="PwdPassword"
                Grid.Row="4"
                FontSize="10"
                Margin="0,0,0,10"
                HorizontalAlignment="Stretch"
                Width="200"
                Height="15"/> 
            
        </Grid> 

        <Button
            x:Name="BtnReturn"
            Grid.Column="0"
            Grid.Row="2"
            Width="50"
            HorizontalAlignment="Center"
            Height="15"
            FontSize="10"
            Style="{StaticResource DefaultButton}"
            Content="Volver" 
            Click="BtnReturn_Click"/> 

        <Button
            x:Name="BtnSignUp"
            Grid.Column="2"
            Grid.Row="3"
            Width="50"
            Height="15"
            FontSize="10"
            Style="{StaticResource DefaultButton}"
            Content="Registrarse" 
            Click="BtnSignUp_Click"/> 

    </Grid>
</Window>


