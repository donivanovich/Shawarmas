<Page x:Class="Wpf10_Shawarmas.MVVM.View.ViewEfforts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf10_Shawarmas.MVVM.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ViewEfforts">

    <Grid Background="#1C1C1C">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer 
            Grid.Column="0"
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto">
            
            <ItemsControl 
                ItemsSource="{Binding Pedidos}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding NumColumnas}" Rows="{Binding NumFilas}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button 
                            Command="{Binding DataContext.SeleccionarPedidoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Padding="15"
                            Width="155"
                            Height="120"
                            Margin="10,10,0,0"
                            Background="#2C2C2C"
                            BorderBrush="#444"
                            BorderThickness="1"
                            Cursor="Hand">

                            <Button.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="15">

                                                    <ContentPresenter 
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>

                                                </Border>
                                                
                                                <ControlTemplate.Triggers>
                                                    <Trigger 
                                                        Property="IsMouseOver" 
                                                        Value="True">

                                                        <Setter 
                                                            TargetName="border" 
                                                            Property="Background" 
                                                            Value="#444"/>

                                                        <Setter 
                                                            TargetName="border" 
                                                            Property="BorderBrush" 
                                                            Value="#666"/>

                                                    </Trigger>
                                                    
                                                    <Trigger 
                                                        Property="IsPressed" 
                                                        Value="True">

                                                        <Setter 
                                                            TargetName="border" 
                                                            Property="Background" 
                                                            Value="#555"/>

                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Resources>

                            <StackPanel>
                                <TextBlock 
                                    Text="Order #" 
                                    Foreground="#CCC" 
                                    FontWeight="SemiBold" 
                                    FontSize="14"/>

                                <TextBlock 
                                    Text="{Binding IdPedido}" 
                                    Foreground="#FFF" 
                                    FontWeight="Bold" 
                                    FontSize="18"/> <!-- OrderID -->

                                <TextBlock 
                                    Text="{Binding Cliente.Nombre}" 
                                    Foreground="#EEE"
                                    FontSize="14"/> <!-- Client Name -->

                                <TextBlock 
                                    Text="{Binding FechaPedido, StringFormat=d}" 
                                    Foreground="#AAA" 
                                    FontSize="12"/> <!-- Date -->
                                
                            </StackPanel>
                        </Button> <!-- Order Card -->
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer> <!-- Orders -->

        <Border 
            Grid.Row="1"
            Background="#2C2C2C"
            CornerRadius="10"
            Padding="20"
            Margin="10">
            
            <StackPanel HorizontalAlignment="Center">
                <TextBlock 
                    Text="Grid Configuration"
                    FontWeight="Bold"
                    FontSize="18"
                    Foreground="#FFF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,15"/> <!-- Title -->

                <StackPanel Orientation="Horizontal">
                    <StackPanel
                        Margin="0,0,10,0">
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                            <TextBlock 
                                Text="Initial Probability:"
                                Foreground="#CCC"
                                Width="120"/>

                            <TextBox 
                                Text="{Binding ProbInicial, UpdateSourceTrigger=PropertyChanged}"
                                Width="80"
                                HorizontalContentAlignment="Center"
                                Background="#444"
                                Foreground="#FFF"
                                BorderBrush="#666"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Text="Initial State (0/1):"
                                Foreground="#CCC"
                                Width="120"/>

                            <TextBox 
                                Text="{Binding EstadoInicial, UpdateSourceTrigger=PropertyChanged}"
                                Width="80"
                                HorizontalContentAlignment="Center"
                                Background="#444"
                                Foreground="#FFF"
                                BorderBrush="#666"
                                MaxLength="1"/>

                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Orientation="Vertical">
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                            <TextBlock 
                                Text="Rows:"
                                Foreground="#CCC"
                                Width="80"/>

                            <TextBox 
                                Text="{Binding NumFilas, UpdateSourceTrigger=PropertyChanged}"
                                Width="80"
                                HorizontalContentAlignment="Center"
                                Background="#444"
                                Foreground="#FFF"
                                BorderBrush="#666"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock 
                                Text="Columns:"
                                Foreground="#CCC"
                                Width="80"/>

                            <TextBox 
                                Text="{Binding NumColumnas, UpdateSourceTrigger=PropertyChanged}"
                                Width="80"
                                HorizontalContentAlignment="Center"
                                Background="#444"
                                Foreground="#FFF"
                                BorderBrush="#666"/>

                        </StackPanel>
                    </StackPanel>
                </StackPanel> <!-- Inputs -->

                <Button 
                    Command="{Binding InicializarGrillaCommand}"
                    Content="Initialize Grid"
                    Style="{StaticResource DefaultButton}"
                    Width="150"
                    Height="35"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Background="#FFF0F0F0"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"/> <!-- Initialize Button -->

            </StackPanel>
        </Border> <!-- Grid Configuration -->

        <ContentControl 
            Grid.Column="1" 
            Content="{Binding PedidoSeleccionado}" 
            Margin="10" Cursor=""
            Grid.RowSpan="2">

            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border 
                        Background="#2C2C2C" 
                        CornerRadius="10" 
                        Padding="10" Cursor="">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock 
                                Grid.Row="0"
                                Text="Items" 
                                FontWeight="Bold" 
                                HorizontalAlignment="Center"
                                FontSize="16" 
                                Foreground="#FFF" 
                                Margin="0,0,0,10"/>

                            <ScrollViewer 
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                Margin="0,0,0,10">

                                <ItemsControl ItemsSource="{Binding Productos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border 
                                                Background="#333" 
                                                CornerRadius="8" 
                                                Padding="8" 
                                                Margin="0,5">

                                                <StackPanel 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Center">

                                                    <TextBlock 
                                                        Visibility="Collapsed" 
                                                        x:Name="rutaGenerada" 
                                                        Text="{Binding Imagen, StringFormat=/Resources{0}}"/>

                                                    <Image 
                                                        Source="{Binding ElementName=rutaGenerada, Path=Text}" 
                                                        Width="75" 
                                                        Height="75" 
                                                        Margin="10,0,10,0"/>

                                                    <StackPanel
                                                        VerticalAlignment="Center"
                                                        Margin="5,0,15,0">
                                                        
                                                        <TextBlock 
                                                            Text="{Binding Marca}"
                                                            FontWeight="Bold"
                                                            Foreground="#FFF"/>

                                                        <TextBlock 
                                                            Text="{Binding Modelo}" 
                                                            Foreground="#CCC"/>
                                                        
                                                    </StackPanel>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock 
                                                            Text="{Binding Precio, StringFormat=C}"
                                                            Foreground="#AAA"/>

                                                        <TextBlock Foreground="#AAA">
                                                            <Run Text="Size:"/>
                                                            <Run Text="{Binding Talla}"/>
                                                        </TextBlock>

                                                        <TextBlock Foreground="#AAA">
                                                            <Run Text="x"/>                                                         
                                                            <Run Text="{Binding Cantidad}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer> <!-- Items Details -->

                            <StackPanel Grid.Row="2">
                                <Border 
                                    Background="#3A3A3A" 
                                    CornerRadius="8" 
                                    Padding="12" 
                                    Margin="0,0,0,10">

                                    <StackPanel>
                                        <TextBlock 
                                            Text="Details" 
                                            FontWeight="Bold" 
                                            HorizontalAlignment="Center"
                                            FontSize="14" 
                                            Foreground="#FFF" 
                                            Margin="0,0,0,8"/>

                                        <TextBlock Foreground="#FFF" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap">
                                            <Run Text="{Binding Cliente.Nombre, FallbackValue='Name'}"/>
                                            <Run Text="{Binding Cliente.Apellido1}"/>
                                            <Run Text="{Binding Cliente.Apellido2}"/>
                                            <LineBreak/>
                                            <Run Text="{Binding Cliente.Mail, FallbackValue='Mail'}" />
                                            <LineBreak/>
                                            <Run Text="{Binding Calle, FallbackValue='Address'}" />
                                            <LineBreak/>
                                            <Run Text="{Binding Ciudad, FallbackValue='City'}"/>
                                            <Run Text=", " />
                                            <Run Text="{Binding Pais, FallbackValue='Country'}" />
                                            <LineBreak/>
                                            <Run Text="{Binding Postal, FallbackValue='ZIP'}" />
                                        </TextBlock>

                                        <TextBlock 
                                            Text="{Binding FechaPedido, StringFormat='Date: {0:dd/MM/yyyy}', FallbackValue='Date: Pending'}" 
                                            Foreground="#CCC" 
                                            FontSize="11"/>
                                        
                                    </StackPanel>
                                </Border>

                                <Button 
                                    Style="{StaticResource StatusOrdenButton}"
                                    Command="{Binding DataContext.MarcarComoCompletadoCommand, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                    CommandParameter="{Binding}"
                                    Content="Mark as completed"
                                    HorizontalAlignment="Center"
                                    Width="140" 
                                    Height="35"/> <!-- Completed Button -->
                                
                            </StackPanel> <!-- Client Details & Completed Button -->
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl> <!-- Orders Details -->
    </Grid>
</Page>
